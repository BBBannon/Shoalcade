<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Shoalcade</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Shoalcade</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AnalysisMode>Recommended</AnalysisMode>
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Pages\*" />
    <!-- RPG Maker player files (D147), served at /shoalcade/web/rpgmaker/<name>; the compat script is the phone's own
         copy (one file, never duplicated), served at /shoalcade/web/rpgmaker/shoalcade_compat.rb. -->
    <EmbeddedResource Include="Pages\rpgmaker\*" LogicalName="Jellyfin.Plugin.Shoalcade.Pages.rpgmaker/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\android\app\src\main\assets\rpgmaker\shoalcade_compat.rb" LogicalName="Jellyfin.Plugin.Shoalcade.Pages.rpgmaker/shoalcade_compat.rb" />
    <!-- The pinned EmulatorJS version is read from here at run time (B3), so /info can never drift from what build.sh bundles. -->
    <EmbeddedResource Include="..\emulatorjs.lock" LogicalName="Jellyfin.Plugin.Shoalcade.emulatorjs.lock" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Shoalcade.Tests" />
  </ItemGroup>

</Project>
