// Shoalcade.exe resources: icon, manifest, version. Part of Shoalcade, GPL-3.0-or-later.
// SC_ICON, SC_VER_COMMA, SC_VER_STR, SC_APP_NAME_A come from tools/build_windows_release.sh.
#include <winver.h>
1 ICON SC_ICON
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SC_VER_COMMA
PRODUCTVERSION SC_VER_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "Shoalcade"
      VALUE "FileDescription", SC_APP_NAME_A
      VALUE "FileVersion", SC_VER_STR
      VALUE "InternalName", "Shoalcade"
      VALUE "LegalCopyright", "GPL-3.0-or-later. See licences folder."
      VALUE "OriginalFilename", "Shoalcade.exe"
      VALUE "ProductName", SC_APP_NAME_A
      VALUE "ProductVersion", SC_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
