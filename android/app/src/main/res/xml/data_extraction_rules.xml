<?xml version="1.0" encoding="utf-8"?>
<!--
  I6: nothing leaves the phone in a cloud backup or a phone-to-phone transfer (Android 12+; allowBackup="false"
  already covers Android 11 and adb backup).
  - Login: the token is encrypted with an Android Keystore key that never leaves the phone, so a copied session file
    can't be read on a new phone (and could stop the app opening it).
  - Games: large, and Jellyfin is the source of truth; download them again.
  - Saves and sync state: Jellyfin keeps every uploaded save. Copying sync state without the matching server and
    login invites wrong "last synced" answers. Before changing phones, Push all, then log in on the new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
