+void Patch::ShoalcadeSetCheats(std::string pnach_text)
+{
+	{
+		std::lock_guard<std::mutex> lk(s_sc_cheats_lock);
+		s_sc_cheats_text = std::move(pnach_text);
+	}
+	Host::RunOnCPUThread([]() {
+		UpdateActivePatches(false, false, false, false);
+		// "once" lines can't wait for the next boot: apply them now, once.
+		std::vector<const PatchCommand*> mine;
+		for (const PatchGroup& g : s_sc_cheat_patches)
+			for (const PatchCommand& c : g.patches)
+				mine.push_back(&c);
+		EEMemoryInterface ee;
+		IOPMemoryInterface iop;
+		ApplyPatches(mine, PPT_ONCE_ON_LOAD, ee, iop);
+		Console.WriteLnFmt("Shoalcade: {} cheat line(s) active", mine.size());
+	});
+}
