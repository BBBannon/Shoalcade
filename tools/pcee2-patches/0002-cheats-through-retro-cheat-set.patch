+// Shoalcade (tools/pcee2-patches/0002): cheats through retro_cheat_set, as in Shoalcade's LRPS2 patch. A code
+// is one or more lines joined by '+' (or new lines); each line is a pnach line
+// ("patch=1,EE,2XXXXXXX,extended,YYYYYYYY") or a raw decrypted code ("XXXXXXXX YYYYYYYY", which becomes
+// patch=1,EE,XXXXXXXX,extended,YYYYYYYY: applied every vsync). A code with an unreadable line is skipped whole.
+static std::map<unsigned, std::vector<std::string>> s_sc_cheat_codes;
+
+static void ScCheatsPublish()
+{
+	std::string text;
+	for (const auto& kv : s_sc_cheat_codes)
+		for (const std::string& line : kv.second)
+			text.append(line).append("\n");
+	Patch::ShoalcadeSetCheats(std::move(text));
+}
+
+static bool ScIsHex(const std::string& s)
+{
+	if (s.empty())
+		return false;
+	for (char c : s)
+		if (!std::isxdigit(static_cast<unsigned char>(c)))
+			return false;
+	return true;
+}
+
+void retro_cheat_reset(void)
+{
+	s_sc_cheat_codes.clear();
+	ScCheatsPublish();
+}
+
+void retro_cheat_set(unsigned index, bool enabled, const char* code)
+{
+	s_sc_cheat_codes.erase(index);
+	if (enabled && code)
+	{
+		std::vector<std::string> lines;
+		const std::string text(code);
+		std::string piece;
+		for (size_t i = 0; i <= text.size(); i++)
+		{
+			const char ch = i < text.size() ? text[i] : '+';
+			if (ch != '+' && ch != '\n' && ch != '\r')
+			{
+				piece += ch;
+				continue;
+			}
+			std::string line; // trimmed, runs of blanks folded to one space
+			bool space = false;
+			for (char c : piece)
+			{
+				if (c == ' ' || c == '\t')
+				{
+					space = !line.empty();
+					continue;
+				}
+				if (space)
+					line += ' ';
+				space = false;
+				line += c;
+			}
+			piece.clear();
+			if (line.empty())
+				continue;
+			if (line.compare(0, 6, "patch=") == 0)
+			{
+				lines.push_back(line);
+				continue;
+			}
+			std::string a, b;
+			const size_t sp = line.find(' ');
+			if (sp != std::string::npos)
+			{
+				a = line.substr(0, sp);
+				b = line.substr(sp + 1);
+			}
+			else if (line.size() == 16)
+			{
+				a = line.substr(0, 8);
+				b = line.substr(8);
+			}
+			if (a.size() != 8 || b.size() != 8 || !ScIsHex(a) || !ScIsHex(b))
+			{
+				Console.WarningFmt("Shoalcade: cheat {} skipped, unreadable line: {}", index, line);
+				lines.clear();
+				break;
+			}
+			lines.push_back("patch=1,EE," + a + ",extended," + b);
+		}
+		if (!lines.empty())
+			s_sc_cheat_codes[index] = std::move(lines);
+	}
+	ScCheatsPublish();
+}
 
