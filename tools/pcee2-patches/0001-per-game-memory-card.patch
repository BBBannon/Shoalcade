Shoalcade: the game's own memory card for the PCEE2 libretro core (PS2), as LRPS2 has it.
Upstream PCEE2 keeps every memory card in <system>/pcsx2/memcards (Mcd001.ps2 shared by every game and every
Shoalcade user on the PC). With this patch, when the frontend gives content and a save directory, slot 1 is
<save dir>/<content name without its extension>.ps2 and slot 2 is off - the same file name and the same 8 MB .ps2
format LRPS2 uses with pcsx2_shared_memory_cards=disabled, so one card works in either core. These settings win over
the memory-card core options. With no content (BIOS menu) or no save directory, the shared cards are used as before.
PCSX2 creates the card (8 MB, all 0xFF, as LRPS2) the first time a game boots with it; nothing else is moved or
rewritten.

diff --git a/pcee2-libretro/Libretro.cpp b/pcee2-libretro/Libretro.cpp
index 663e60b03..dc04194f2 100644
--- a/pcee2-libretro/Libretro.cpp
+++ b/pcee2-libretro/Libretro.cpp
@@ -109,6 +109,12 @@ namespace LibretroHost
 	static MemorySettingsInterface s_settings_interface;
 	static std::string s_system_dir;
 
+	// Shoalcade (tools/pcee2-patches/0001): the game's own memory card, <save dir>/<content name>.ps2
+	// in slot 1 (slot 2 off), as LRPS2 does with pcsx2_shared_memory_cards=disabled, so one card file
+	// works in either core. Empty (no content, or no save directory) = PCSX2's shared cards.
+	static std::string s_sc_card_dir;
+	static std::string s_sc_card_file;
+
 	// CPU thread management. The thread persists across game sessions (like
 	// the Qt frontend's EmuThread) because VMManager::Internal::
 	// CPUThreadInitialize may only run once per process (page fault handler,
@@ -1331,6 +1337,17 @@ void LibretroHost::ReadCoreOptions(bool startup)
 		if (const char* filename = get_option("pcsx2_memcard_slot2_file", nullptr))
 			s_settings_interface.SetStringValue("MemoryCards", "Slot2_Filename", filename);
 	}
+
+	// Shoalcade (tools/pcee2-patches/0001): the game's own card wins over every card option.
+	if (!s_sc_card_file.empty())
+	{
+		s_settings_interface.SetStringValue("Folders", "MemoryCards", s_sc_card_dir.c_str());
+		s_settings_interface.SetBoolValue("MemoryCards", "Slot1_Enable", true);
+		s_settings_interface.SetStringValue("MemoryCards", "Slot1_Filename", s_sc_card_file.c_str());
+		s_settings_interface.SetBoolValue("MemoryCards", "Slot2_Enable", false);
+	}
+	else
+		s_settings_interface.DeleteValue("Folders", "MemoryCards");
 }
 
 void LibretroHost::CPUThreadMain()
@@ -2516,8 +2533,28 @@ bool retro_load_game(const struct retro_game_info* game)
 	// up driving it.
 	GSLibretro::Active = HWRenderActive();
 
+	// Shoalcade (tools/pcee2-patches/0001): the game's own memory card in the save directory, named
+	// after the content without its extension (as LRPS2: <save dir>/<name>.ps2).
+	s_sc_card_dir.clear();
+	s_sc_card_file.clear();
+	if (!no_content)
+	{
+		const char* save_dir = nullptr;
+		if (s_environ_cb(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &save_dir) && save_dir && save_dir[0])
+		{
+			const std::string_view name = Path::GetFileTitle(game->path);
+			if (!name.empty())
+			{
+				s_sc_card_dir = save_dir;
+				s_sc_card_file = std::string(name) + ".ps2";
+				Console.WriteLnFmt("Shoalcade: memory card {}", Path::Combine(s_sc_card_dir, s_sc_card_file));
+			}
+		}
+	}
+
 	ReadCoreOptions(true);
 	SettingsOverride();
+	VMManager::Internal::UpdateEmuFolders(); // Shoalcade: picks up the card folder set above
 
 	SPU2::CustomOutputStreamFactory = &CreateLibretroAudioStream;
 	InputManager::SetPadVibrationCallback(&PadVibrationCallback);
