+// Shoalcade (tools/dolphin-patches/0001): a code the frontend sends that is not one of the game's INI
+// codes is added as a new code. Lines are joined by '+' (or new lines). Type: "AR:" in front = Action
+// Replay, "GECKO:" = Gecko; with neither, dashed lines (XXXX-XXXX-XXXXX) are encrypted Action Replay
+// and plain "XXXXXXXX YYYYYYYY" lines are Gecko (Shoalcade decision D-4). Unreadable codes are skipped.
+static std::string shoalcade_clean_line(const std::string& raw)
+{
+  std::string out;
+  bool space = false;
+  for (char ch : raw)
+  {
+    if (ch == ' ' || ch == '\t')
+    {
+      space = !out.empty();
+      continue;
+    }
+    if (space)
+      out += ' ';
+    space = false;
+    out += ch;
+  }
+  // "XXXXXXXXYYYYYYYY" (16 hex digits, no space) -> "XXXXXXXX YYYYYYYY"
+  if (out.size() == 16 && out.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos)
+    out.insert(8, " ");
+  return out;
+}
+
+static bool shoalcade_add_cheat(unsigned index, const char* code)
+{
+  std::string text(code ? code : "");
+  enum class Kind { Auto, AR, Gecko } kind = Kind::Auto;
+  const size_t lead = text.find_first_not_of(" \t\r\n");
+  text.erase(0, lead == std::string::npos ? text.size() : lead);
+  auto take_prefix = [&text](const char* p) {
+    const size_t n = std::strlen(p);
+    if (text.size() < n)
+      return false;
+    for (size_t i = 0; i < n; i++)
+      if (std::toupper(static_cast<unsigned char>(text[i])) != p[i])
+        return false;
+    text.erase(0, n);
+    return true;
+  };
+  if (take_prefix("AR:"))
+    kind = Kind::AR;
+  else if (take_prefix("GECKO:"))
+    kind = Kind::Gecko;
+
+  std::vector<std::string> lines;
+  std::string piece;
+  for (size_t i = 0; i <= text.size(); i++)
+  {
+    const char ch = i < text.size() ? text[i] : '+';
+    if (ch == '+' || ch == '\n' || ch == '\r')
+    {
+      std::string line = shoalcade_clean_line(piece);
+      if (!line.empty())
+        lines.push_back(line);
+      piece.clear();
+    }
+    else
+      piece += ch;
+  }
+  if (lines.empty())
+    return false;
+
+  bool dashed = true;
+  for (const auto& line : lines)
+    dashed = dashed && line.find('-') != std::string::npos;
+  if (kind == Kind::Auto)
+    kind = dashed ? Kind::AR : Kind::Gecko;
+
+  const std::string name = fmt::format("Shoalcade cheat {}", index);
+  if (kind == Kind::AR)
+  {
+    ActionReplay::ARCode c;
+    c.name = name;
+    c.enabled = true;
+    c.user_defined = true;
+    std::vector<std::string> encrypted;
+    for (const auto& line : lines)
+    {
+      const auto parsed = ActionReplay::DeserializeLine(line);
+      if (std::holds_alternative<ActionReplay::AREntry>(parsed))
+        c.ops.push_back(std::get<ActionReplay::AREntry>(parsed));
+      else if (std::holds_alternative<ActionReplay::EncryptedLine>(parsed))
+        encrypted.push_back(std::get<ActionReplay::EncryptedLine>(parsed));
+      else
+      {
+        WARN_LOG_FMT(ACTIONREPLAY, "Shoalcade: not an Action Replay line: {}", line);
+        return false;
+      }
+    }
+    if (!encrypted.empty() &&
+        (!c.ops.empty() || !ActionReplay::DecryptARCode(encrypted, &c.ops) || c.ops.empty()))
+    {
+      WARN_LOG_FMT(ACTIONREPLAY, "Shoalcade: encrypted Action Replay code not accepted");
+      return false;
+    }
+    Libretro::g_ar_codes.push_back(std::move(c));
+  }
+  else
+  {
+    Gecko::GeckoCode g;
+    g.name = name;
+    g.enabled = true;
+    g.user_defined = true;
+    for (const auto& line : lines)
+    {
+      const auto parsed = Gecko::DeserializeLine(line);
+      if (!parsed)
+      {
+        WARN_LOG_FMT(ACTIONREPLAY, "Shoalcade: not a Gecko line: {}", line);
+        return false;
+      }
+      g.codes.push_back(*parsed);
+    }
+    Libretro::g_gecko_codes.push_back(std::move(g));
+  }
+  NOTICE_LOG_FMT(ACTIONREPLAY, "Shoalcade: cheat {} added ({}, {} line(s))", index,
+                 kind == Kind::AR ? "Action Replay" : "Gecko", lines.size());
+  return true;
+}
+
+// On the CPU thread: the lists become the active codes.
+static void shoalcade_apply_cheats_here()
+{
+  const std::string& game_id = SConfig::GetInstance().GetGameID();
+  const u16 game_revision = SConfig::GetInstance().GetRevision();
+  ActionReplay::ApplyCodes(Libretro::g_ar_codes, game_id, game_revision);
+  Gecko::SetActiveCodes(Libretro::g_gecko_codes, game_id, game_revision);
+}
+
+// A title boot (PatchEngine::LoadPatches) applies these lists too, so codes set before the game has booted (the
+// frontend's start-up cheats) aren't replaced by the INI's.
+[[maybe_unused]] static const bool s_shoalcade_cheats_hook =
+    (PatchEngine::SetCheatCodesOverride(&shoalcade_apply_cheats_here), true);
+
+static void shoalcade_apply_cheats()
+{
+  Core::RunOnCPUThread(Core::System::GetInstance(), [] { shoalcade_apply_cheats_here(); }, true);
 }
 
