+// Shoalcade (tools/lrps2-patches/0003): the frontend's cheats live in Patch beside the game's own
+// patches, marked with enabled == SC_FRONTEND_CHEAT (still "on" for _ApplyPatch). They are put back
+// after every reload of the patch list (ForgetLoadedPatches marks them for the next sync).
+#define SC_FRONTEND_CHEAT 2
+static std::mutex                s_sc_cheats_lock;
+static std::vector<std::string>  s_sc_cheats;
+static std::atomic<bool>         s_sc_cheats_dirty{false};
+
+void ShoalcadeCheats_Set(const std::vector<std::string>& pnach_lines)
+{
+	std::lock_guard<std::mutex> lk(s_sc_cheats_lock);
+	s_sc_cheats = pnach_lines;
+	s_sc_cheats_dirty = true;
+}
+
+void ShoalcadeCheats_Sync(void)
+{
+	if (!s_sc_cheats_dirty.exchange(false))
+		return;
+	std::vector<std::string> lines;
+	{
+		std::lock_guard<std::mutex> lk(s_sc_cheats_lock);
+		lines = s_sc_cheats;
+	}
+	Patch.erase(std::remove_if(Patch.begin(), Patch.end(),
+		[](const IniPatch& p) { return p.enabled == SC_FRONTEND_CHEAT; }), Patch.end());
+	for (const std::string& line : lines)
+	{
+		const size_t before = Patch.size();
+		LoadPatchesFromString(line.c_str());
+		for (size_t i = before; i < Patch.size(); i++)
+		{
+			Patch[i].enabled = SC_FRONTEND_CHEAT;
+			// "once" lines can't wait for the next boot: apply them now, once.
+			if (Patch[i].placetopatch == PPT_ONCE_ON_LOAD || Patch[i].placetopatch == PPT_COMBINED_0_1)
+				_ApplyPatch(&Patch[i]);
+		}
+	}
+	log_cb(RETRO_LOG_INFO, "Shoalcade: %zu cheat line(s) active\n", lines.size());
+}
+
 void ForgetLoadedPatches(void)
 {
 	Patch.clear();
 	DynaPatch.clear();
+	s_sc_cheats_dirty = true; // Shoalcade: put the frontend's cheats back at the next sync
 }
 
