-void retro_cheat_reset(void) { }
+// Shoalcade (tools/lrps2-patches/0003): cheats through retro_cheat_set. A code is one or more lines
+// joined by '+' (or new lines). Each line is either a pnach line ("patch=1,EE,2XXXXXXX,extended,YYYYYYYY")
+// or a raw decrypted code ("XXXXXXXX YYYYYYYY"), which becomes patch=1,EE,XXXXXXXX,extended,YYYYYYYY
+// (applied every vsync, as PCSX2's own cheats). A code with an unreadable line is skipped whole.
+static std::map<unsigned, std::vector<std::string>> s_sc_cheat_codes;
 
-void retro_cheat_set(unsigned index, bool enabled, const char* code) { }
+static void sc_cheats_publish(void)
+{
+	std::vector<std::string> all;
+	for (const auto& kv : s_sc_cheat_codes)
+		all.insert(all.end(), kv.second.begin(), kv.second.end());
+	ShoalcadeCheats_Set(all);
+}
+
+static bool sc_is_hex(const std::string& s)
+{
+	if (s.empty())
+		return false;
+	for (char c : s)
+		if (!isxdigit(static_cast<unsigned char>(c)))
+			return false;
+	return true;
+}
+
+void retro_cheat_reset(void)
+{
+	s_sc_cheat_codes.clear();
+	sc_cheats_publish();
+}
+
+void retro_cheat_set(unsigned index, bool enabled, const char* code)
+{
+	s_sc_cheat_codes.erase(index);
+	if (enabled && code)
+	{
+		std::vector<std::string> lines;
+		std::string text(code), piece;
+		for (size_t i = 0; i <= text.size(); i++)
+		{
+			const char ch = i < text.size() ? text[i] : '+';
+			if (ch != '+' && ch != '\n' && ch != '\r')
+			{
+				piece += ch;
+				continue;
+			}
+			// trim, and fold runs of blanks to one space
+			std::string line;
+			bool space = false;
+			for (char c : piece)
+			{
+				if (c == ' ' || c == '\t') { space = !line.empty(); continue; }
+				if (space) line += ' ';
+				space = false;
+				line += c;
+			}
+			piece.clear();
+			if (line.empty())
+				continue;
+			if (line.compare(0, 6, "patch=") == 0)
+				lines.push_back(line);
+			else
+			{
+				std::string a, b;
+				const size_t sp = line.find(' ');
+				if (sp != std::string::npos) { a = line.substr(0, sp); b = line.substr(sp + 1); }
+				else if (line.size() == 16) { a = line.substr(0, 8); b = line.substr(8); }
+				if (a.size() != 8 || b.size() != 8 || !sc_is_hex(a) || !sc_is_hex(b))
+				{
+					log_cb(RETRO_LOG_WARN, "Shoalcade: cheat %u skipped, unreadable line: %s\n", index, line.c_str());
+					lines.clear();
+					break;
+				}
+				lines.push_back("patch=1,EE," + a + ",extended," + b);
+			}
+		}
+		if (!lines.empty())
+			s_sc_cheat_codes[index] = std::move(lines);
+	}
+	sc_cheats_publish();
+}
 
